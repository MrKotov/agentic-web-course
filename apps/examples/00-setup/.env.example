# Копирайте този файл като .env и попълнете стойностите.
# .env НИКОГА не се комитва — вече е в .gitignore.

# Ключ от https://openrouter.ai/keys (безплатен, без карта).
# Форматът е sk-or-v1-... .
OPENROUTER_API_KEY=

# Модел, който ще се ползва по подразбиране. Оставете безплатния.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Как се изпълняват примерите:
#   recorded  — чете от demo/recordings/, без мрежа и без ключ (по подразбиране)
#   live      — прави истинска заявка към доставчика
COURSE_MODE=recorded
