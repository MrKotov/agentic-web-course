# Copy to .env and fill in. Never commit .env.

# Django secret key. Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# 1 for local development, 0 for staging and production.
DJANGO_DEBUG=1

# Comma-separated hostnames. Use the real hostname in production, not *.
DJANGO_ALLOWED_HOSTS=*

# Comma-separated https origins Django will trust for CSRF, e.g.
# https://quiz.example.tu-sofia.bg
DJANGO_CSRF_TRUSTED_ORIGINS=

# Redirect http to https when DJANGO_DEBUG=0. Set to 0 only behind a TLS-terminating proxy
# that already does the redirect.
DJANGO_SECURE_SSL_REDIRECT=1

# Unset locally: the platform then uses SQLite at apps/platform/db.sqlite3 and needs no
# services. Set to a Postgres URL for staging and production, e.g.
# postgres://user:password@host:5432/platform
DATABASE_URL=

# Shared secret the autograder GitHub Actions workflow presents in the
# X-Autograder-Secret header when posting results. Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Store it as a repository secret in each exercise template; it is never in the repo.
AUTOGRADER_SHARED_SECRET=
