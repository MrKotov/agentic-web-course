# Copy to .env (never committed) for local instructor-side use of `autograder submit` /
# `autograder collect`. A student's fork needs NONE of these — see README.md, "Secret
# handling and trust model".

# Root of the platform's autograder app, e.g. https://platform.example.edu/api/autograder
# (matches apps/platform/config/urls.py: "api/autograder/" -> autograder.urls).
AUTOGRADER_PLATFORM_URL=

# Must match AUTOGRADER_SHARED_SECRET in apps/platform/.env exactly. Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Lives only on instructor-controlled infrastructure: the platform itself, and the
# collector job described in README.md. Never in a student repository or template.
AUTOGRADER_SHARED_SECRET=

# Fine-grained GitHub PAT, read-only "Actions" and "Metadata" permissions, scoped to the
# roster's repositories. Used only by `autograder collect` to read workflow-run artifacts.
# Never given to students, never present in a student's workflow.
COLLECTOR_GITHUB_TOKEN=

# Optional: set by exercise 4's workflow (or an instructor's local run) so the deployment
# checks know what to probe. Not a secret.
DEPLOYED_URL=
